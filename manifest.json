{
  "id": "service-manager",
  "name": "Services",
  "version": "1.1.2",
  "description": "Manage services, timers and logs on your hosts over SSH.",
  "author": {
    "name": "Termix"
  },
  "license": "Apache-2.0",
  "repository": "https://github.com/Termix-SSH/Plugin-Service-Manager",
  "docs": "https://docs.termix.site/plugins/service-manager",
  "video": "https://www.youtube.com/watch?v=uVoLykPpvWk",
  "category": "Infrastructure",
  "icon": "ServerCog",
  "features": [
    "List systemd services, sockets, targets and timers with their state",
    "Start, stop, restart, reload, enable, disable and mask units",
    "Unit details with memory, CPU, tasks, uptime and restarts",
    "Edit unit files and overrides, checked with systemd-analyze before saving",
    "Create a new service from a simple form",
    "Timers with the last and next run, and run now",
    "Read the journal by unit, priority, time, boot and text, and follow it live",
    "Browse, search, follow and download log files in /var/log",
    "Get an alert when a watched service fails, and when it is back",
    "A services panel beside any SSH terminal",
    "A dashboard card with every watched service and whether it is up",
    "Services, Timers and Logs cards in Host Metrics",
    "Basic OpenRC support for list, start, stop and boot"
  ],
  "env": [],
  "engine": {
    "termix": ">=26.11.1-0",
    "api": "^1.15"
  },
  "capabilities": [
    "hosts:read",
    "credentials:use",
    "ssh:connect",
    "network:serve",
    "db:own",
    "notify:send",
    "users:impersonate",
    "ui:surface",
    "operations:provide"
  ],
  "contributes": {
    "tabs": [
      {
        "id": "service-manager",
        "titleKey": "tab.title",
        "icon": "ServerCog",
        "openFrom": ["host-context-menu", "palette"]
      }
    ],
    "permissions": [
      {
        "name": "use",
        "titleKey": "permissions.use.title",
        "descriptionKey": "permissions.use.description",
        "defaultRoles": ["admin", "user"]
      }
    ],
    "settings": {
      "host": {
        "enableKey": "enableServices",
        "enableLabelKey": "settings.host.enable.label",
        "enableDescriptionKey": "settings.host.enable.description",
        "enableDefault": false,
        "editorGroup": "ssh",
        "fields": [
          {
            "key": "useSudo",
            "type": "boolean",
            "labelKey": "settings.host.useSudo.label",
            "descriptionKey": "settings.host.useSudo.description",
            "default": true,
            "requires": "enableServices"
          },
          {
            "key": "readOnly",
            "type": "boolean",
            "labelKey": "settings.host.readOnly.label",
            "descriptionKey": "settings.host.readOnly.description",
            "default": false,
            "requires": "enableServices"
          },
          {
            "key": "logPaths",
            "type": "string",
            "labelKey": "settings.host.logPaths.label",
            "descriptionKey": "settings.host.logPaths.description",
            "placeholderKey": "settings.host.logPaths.placeholder",
            "default": "/var/log",
            "requires": "enableServices"
          },
          {
            "key": "showPanel",
            "type": "boolean",
            "labelKey": "settings.host.showPanel.label",
            "descriptionKey": "settings.host.showPanel.description",
            "default": true,
            "requires": "enableServices"
          }
        ]
      },
      "user": [
        {
          "key": "companionAutoOpen",
          "type": "boolean",
          "labelKey": "settings.user.companionAutoOpen.label",
          "descriptionKey": "settings.user.companionAutoOpen.description",
          "default": false
        },
        {
          "key": "companionSide",
          "type": "select",
          "labelKey": "settings.user.companionSide.label",
          "descriptionKey": "settings.user.companionSide.description",
          "default": "right",
          "options": [
            {
              "value": "right",
              "labelKey": "settings.user.companionSide.right"
            },
            {
              "value": "left",
              "labelKey": "settings.user.companionSide.left"
            },
            {
              "value": "bottom",
              "labelKey": "settings.user.companionSide.bottom"
            }
          ]
        },
        {
          "key": "companionSize",
          "type": "number",
          "labelKey": "settings.user.companionSize.label",
          "descriptionKey": "settings.user.companionSize.description",
          "min": 240,
          "max": 900,
          "default": 360
        },
        {
          "key": "companionEdgeButton",
          "type": "boolean",
          "labelKey": "settings.user.companionEdgeButton.label",
          "descriptionKey": "settings.user.companionEdgeButton.description",
          "default": true
        }
      ]
    },
    "dashboardCards": [
      {
        "id": "service-watches",
        "titleKey": "card.title",
        "icon": "ServerCog"
      }
    ],
    "operations": {
      "actions": [
        {
          "id": "service-manager.list-services",
          "titleKey": "operations.list.title",
          "scope": "host",
          "risk": "read",
          "permission": "use",
          "hostAccess": "connect",
          "when": {
            "settings": {
              "enableServices": true
            }
          },
          "surfaces": {
            "assistant": true,
            "mcp": true,
            "palette": false
          }
        },
        {
          "id": "service-manager.failed-units",
          "titleKey": "operations.failed.title",
          "scope": "host",
          "risk": "read",
          "permission": "use",
          "hostAccess": "connect",
          "when": {
            "settings": {
              "enableServices": true
            }
          },
          "surfaces": {
            "assistant": true,
            "mcp": true,
            "palette": false
          }
        },
        {
          "id": "service-manager.start",
          "titleKey": "operations.action.start",
          "icon": "Play",
          "scope": "resource",
          "resource": "service-manager.service",
          "risk": "change",
          "permission": "use",
          "hostAccess": "edit",
          "dryRun": "describe",
          "exclusive": true,
          "when": {
            "settings": {
              "enableServices": true
            }
          },
          "idempotent": true,
          "surfaces": {
            "assistant": true,
            "mcp": true
          }
        },
        {
          "id": "service-manager.stop",
          "titleKey": "operations.action.stop",
          "icon": "Square",
          "scope": "resource",
          "resource": "service-manager.service",
          "risk": "change",
          "permission": "use",
          "hostAccess": "edit",
          "dryRun": "describe",
          "exclusive": true,
          "when": {
            "settings": {
              "enableServices": true
            }
          },
          "idempotent": true,
          "surfaces": {
            "assistant": true,
            "mcp": true
          }
        },
        {
          "id": "service-manager.restart",
          "titleKey": "operations.action.restart",
          "icon": "RotateCw",
          "scope": "resource",
          "resource": "service-manager.service",
          "risk": "change",
          "permission": "use",
          "hostAccess": "edit",
          "dryRun": "describe",
          "exclusive": true,
          "when": {
            "settings": {
              "enableServices": true
            }
          },
          "surfaces": {
            "assistant": true,
            "mcp": true
          }
        },
        {
          "id": "service-manager.reload",
          "titleKey": "operations.action.reload",
          "icon": "RefreshCw",
          "scope": "resource",
          "resource": "service-manager.service",
          "risk": "change",
          "permission": "use",
          "hostAccess": "edit",
          "dryRun": "describe",
          "exclusive": true,
          "when": {
            "settings": {
              "enableServices": true
            }
          },
          "surfaces": {
            "assistant": true,
            "mcp": true
          }
        },
        {
          "id": "service-manager.enable",
          "titleKey": "operations.action.enable",
          "icon": "ToggleRight",
          "scope": "resource",
          "resource": "service-manager.service",
          "risk": "change",
          "permission": "use",
          "hostAccess": "edit",
          "dryRun": "describe",
          "exclusive": true,
          "when": {
            "settings": {
              "enableServices": true
            }
          },
          "idempotent": true
        },
        {
          "id": "service-manager.disable",
          "titleKey": "operations.action.disable",
          "icon": "ToggleLeft",
          "scope": "resource",
          "resource": "service-manager.service",
          "risk": "change",
          "permission": "use",
          "hostAccess": "edit",
          "dryRun": "describe",
          "exclusive": true,
          "when": {
            "settings": {
              "enableServices": true
            }
          },
          "idempotent": true
        },
        {
          "id": "service-manager.enable-now",
          "titleKey": "operations.action.enableNow",
          "icon": "PlayCircle",
          "scope": "resource",
          "resource": "service-manager.service",
          "risk": "change",
          "permission": "use",
          "hostAccess": "edit",
          "dryRun": "describe",
          "exclusive": true,
          "when": {
            "settings": {
              "enableServices": true
            }
          },
          "idempotent": true
        },
        {
          "id": "service-manager.disable-now",
          "titleKey": "operations.action.disableNow",
          "icon": "StopCircle",
          "scope": "resource",
          "resource": "service-manager.service",
          "risk": "change",
          "permission": "use",
          "hostAccess": "edit",
          "dryRun": "describe",
          "exclusive": true,
          "when": {
            "settings": {
              "enableServices": true
            }
          },
          "idempotent": true
        },
        {
          "id": "service-manager.mask",
          "titleKey": "operations.action.mask",
          "icon": "EyeOff",
          "scope": "resource",
          "resource": "service-manager.service",
          "risk": "destructive",
          "permission": "use",
          "hostAccess": "edit",
          "dryRun": "describe",
          "exclusive": true,
          "when": {
            "settings": {
              "enableServices": true
            }
          }
        },
        {
          "id": "service-manager.unmask",
          "titleKey": "operations.action.unmask",
          "icon": "Eye",
          "scope": "resource",
          "resource": "service-manager.service",
          "risk": "change",
          "permission": "use",
          "hostAccess": "edit",
          "dryRun": "describe",
          "exclusive": true,
          "when": {
            "settings": {
              "enableServices": true
            }
          }
        },
        {
          "id": "service-manager.reset-failed",
          "titleKey": "operations.action.resetFailed",
          "icon": "Eraser",
          "scope": "resource",
          "resource": "service-manager.service",
          "risk": "change",
          "permission": "use",
          "hostAccess": "edit",
          "dryRun": "describe",
          "exclusive": true,
          "when": {
            "settings": {
              "enableServices": true
            }
          },
          "surfaces": {
            "assistant": true,
            "mcp": true
          }
        },
        {
          "id": "service-manager.revert",
          "titleKey": "operations.action.revert",
          "icon": "Undo2",
          "scope": "resource",
          "resource": "service-manager.service",
          "risk": "destructive",
          "permission": "use",
          "hostAccess": "edit",
          "dryRun": "describe",
          "exclusive": true,
          "when": {
            "settings": {
              "enableServices": true
            }
          }
        }
      ],
      "resources": [
        {
          "id": "service-manager.service",
          "titleKey": "operations.service.title",
          "icon": "Cog",
          "list": "service-manager.list-services",
          "key": "name",
          "name": "name",
          "status": "active",
          "tab": "service-manager",
          "columns": [
            {
              "key": "description",
              "titleKey": "operations.service.description"
            },
            {
              "key": "sub",
              "titleKey": "operations.service.state",
              "type": "status"
            },
            {
              "key": "fileState",
              "titleKey": "operations.service.boot"
            }
          ],
          "filters": ["active", "fileState"]
        }
      ],
      "signals": [
        {
          "id": "service-manager.failed",
          "titleKey": "operations.failed.title",
          "read": "service-manager.failed-units",
          "scope": "host",
          "kind": "count",
          "refreshSec": 60
        }
      ]
    },
    "uses": ["homepage.widgets"]
  },
  "locales": "locales",
  "platforms": ["linux", "win32", "darwin"]
}
